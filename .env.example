# gRPC server
GRPC_PORT=55053
GRPC_HOST_PORT=55053
GRPC_NETWORK=tcp

# Monobank API
MONOBANK_BASE_URL=https://api.monobank.ua
MONOBANK_CURRENCY_ENDPOINT=/bank/currency
MONOBANK_REFRESH_INTERVAL=5m

# Kafka connection and request topics
KAFKA_BROKERS=localhost:39092
GET_RELATIVE_RANKING_REQUEST_TOPIC=exchange-rate.get-relative-ranking.request
GET_ALL_RANKING_REQUEST_TOPIC=exchange-rate.get-all-ranking.request
# Host port is different from the main backend Kafka port.
KAFKA_HOST_PORT=39092
KAFKA_ADVERTISED_HOST=localhost

# Redis connection used by the application inside Docker
REDIS_ADDR=localhost:16380
# Leave empty while the local Redis container has no authentication.
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
# Unique host port prevents collisions with Redis instances from other services.
REDIS_HOST_PORT=16380

# Docker images
EXCHANGE_RATE_IMAGE=bank-exchange-rate-service:local
KAFKA_IMAGE=apache/kafka:4.3.1
REDIS_IMAGE=redis:7-alpine
